@charset "utf-8";

.bm-shell { --forest: #123d2b; --forest-dark: #0d3324; --forest-soft: #376048; --lime: #cbf36a; --paper: #f6f6ee; --surface: #fffef9; --ink: #173a2b; --muted: #758176; --line: #e5e9dc; --warning: #95572a; position: relative; display: flex; flex-direction: column; width: 100%; max-width: 430px; height: 100dvh; min-height: 680px; margin: 0px auto; overflow: hidden; background: var(--paper); color: var(--ink); font-family: "DM Sans", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; -webkit-font-smoothing: antialiased; }

.bm-shell * { box-sizing: border-box; }

.bm-scroll { flex: 1 1 0%; min-height: 0px; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: none; padding-bottom: 18px; }

.bm-scroll::-webkit-scrollbar, .bm-pulse-rail::-webkit-scrollbar { display: none; }

.bm-top { padding: max(9px, env(safe-area-inset-top)) 18px 0; background: var(--paper); }

.bm-header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 44px; }

